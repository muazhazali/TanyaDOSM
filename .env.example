ASKDOSM_CHAT_MODEL=gpt-oss:120b
ASKDOSM_OLLAMA_API_KEY=
ASKDOSM_OLLAMA_BASE_URL=https://ollama.com/v1
ASKDOSM_EMBEDDING_MODEL=@cf/baai/bge-m3
ASKDOSM_CLOUDFLARE_ACCOUNT_ID=
ASKDOSM_CLOUDFLARE_API_TOKEN=
ASKDOSM_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts
ASKDOSM_REQUEST_TIMEOUT=30
ASKDOSM_PROVIDER_MAX_RETRIES=2
ASKDOSM_CACHE_DIR=.askdosm-cache
ASKDOSM_CACHE_TTL_HOURS=720
ASKDOSM_MONITOR_INTERVAL_HOURS=168
ASKDOSM_RUN_DB_PATH=.askdosm-cache/runs.sqlite3
ASKDOSM_RUN_RETENTION_DAYS=7
ASKDOSM_MAX_CONCURRENT_RUNS=1
ASKDOSM_MAX_QUESTION_LENGTH=500
# Question-handling strictness. Lower min_match_score to answer more vague
# questions (with an assumption note); lower clarification_gap to clarify less
# often when two datasets score close together.
ASKDOSM_MIN_MATCH_SCORE=0.10
ASKDOSM_CLARIFICATION_GAP=0.03
ASKDOSM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
